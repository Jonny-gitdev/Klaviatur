    <!-- Tutorial / Onboarding -->
    <string name="tutorial_welcome_title">Willkommen bei Klaviatur! 🎹</string>
    <string name="tutorial_welcome_desc">Klaviatur hilft dir, dein Musik-Repertoire zu verwalten, effektiv zu üben und Akkordblätter übersichtlich zu organisieren.</string>
    <string name="tutorial_repertoire_title">1. Repertoire &amp; Stücke</string>
    <string name="tutorial_repertoire_desc">Erfasse deine Stücke mit Komponist, Epoche, Schwierigkeit und Taktanzahl. Unterteile Stücke in Abschnitte und verfolge deinen Lernfortschritt.</string>
    <string name="tutorial_sessions_title">2. Übungssessions &amp; Timer</string>
    <string name="tutorial_sessions_desc">Nutze den Übungs-Timer mit Fokus-Modus und integriertem Metronom. Halte deinen täglichen Übungs-Streak aufrecht!</string>
    <string name="tutorial_chords_title">3. Akkorde &amp; Import</string>
    <string name="tutorial_chords_desc">Importiere Songs aus Ordnern, erstelle Playlists oder konvertiere Chords direkt von Ultimate Guitar. Mit automatischem Bildlauf beim Spielen!</string>
    <string name="tutorial_lists_stats_title">4. Listen &amp; Statistik</string>
    <string name="tutorial_lists_stats_desc">Erstelle Programme für Auftritte und Vorspiele und verfolge deine Übungsstatistiken über Wochen und Monate.</string>
    <string name="tutorial_next">Weiter</string>
    <string name="tutorial_prev">Zurück</string>
    <string name="tutorial_finish">Los geht\'s!</string>

