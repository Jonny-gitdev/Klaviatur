    <!-- Tutorial / Onboarding -->
    <string name="tutorial_welcome_title">Welcome to Klaviatur! 🎹</string>
    <string name="tutorial_welcome_desc">Klaviatur helps you manage your music repertoire, practice effectively, and organize chord sheets.</string>
    <string name="tutorial_repertoire_title">1. Repertoire &amp; Pieces</string>
    <string name="tutorial_repertoire_desc">Track your pieces with composer, epoch, difficulty, and total bars. Divide pieces into sections and monitor your progress.</string>
    <string name="tutorial_sessions_title">2. Practice Sessions &amp; Timer</string>
    <string name="tutorial_sessions_desc">Use the practice timer with Focus Mode and built-in metronome. Keep your daily practice streak alive!</string>
    <string name="tutorial_chords_title">3. Chords &amp; Import</string>
    <string name="tutorial_chords_desc">Import songs from folders, create playlists, or convert chords directly from Ultimate Guitar. Features auto-scroll while playing!</string>
    <string name="tutorial_lists_stats_title">4. Lists &amp; Statistics</string>
    <string name="tutorial_lists_stats_desc">Create programs for recitals and concerts, and track your practice statistics over weeks and months.</string>
