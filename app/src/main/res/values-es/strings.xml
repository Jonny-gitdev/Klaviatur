    <string name="tutorial_repertoire_desc">Registra tus piezas con compositor, época, dificultad y compases. Divide las piezas en secciones y sigue tu progreso.</string>
    <string name="tutorial_sessions_title">2. Sesiones de práctica y temporizador</string>
    <string name="tutorial_sessions_desc">Usa el temporizador de práctica con modo Enfoque y metrónomo integrado. ¡Mantén tu racha diaria de práctica!</string>
